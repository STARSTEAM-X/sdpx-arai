# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า — ห้าม commit ไฟล์ .env

# origin ที่อนุญาตให้เรียก API ได้ คั่นด้วย comma (ห้ามใช้ *)
CORS_ORIGINS=http://localhost:5173

# DATABASE_URL — ยังไม่ใช้ใน WS-01/WS-02
# จะเปิดใช้ตอน WS-03 พร้อมกับตอนสร้าง Render Postgres
# DATABASE_URL=postgresql://user:password@host:5432/paireval
