# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า — ห้าม commit ไฟล์ .env

# origin ที่อนุญาตให้เรียก API ได้ คั่นด้วย comma (ห้ามใช้ *)
CORS_ORIGINS=

# ★ ตัวควบคุมความปลอดภัยที่สำคัญที่สุด
# ถ้าไม่ใช่ production endpoint POST /api/test/seed|cleanup|session จะเปิดขึ้นมา
# ค่า default ในโค้ดคือ production — ตั้งเป็น development เฉพาะบนเครื่องตัวเองเท่านั้น
# ค่าที่รู้จัก: development · test · staging · production (อย่างอื่น = ปิด /api/test/*)
ENVIRONMENT=

# ใช้เฉพาะ ENVIRONMENT=staging — เปิด /api/test/* ให้ request ที่แนบ X-Test-Support-Token ตรงกัน
# (k6 ใช้ขอ session ของนักศึกษา · WS-07) · ว่างหรือสั้นกว่า 32 ตัว = ปิด
TEST_SUPPORT_TOKEN=

# ต้องยาวอย่างน้อย 32 bytes (RFC 7518 §3.2) — app จะไม่ยอมเริ่มถ้าสั้นกว่านี้
# สร้างค่าใหม่: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

DATABASE_URL=

# OAuth Client ID ของ Google — ค่าสาธารณะ ไม่ใช่ secret
# ต้องตรงกับ VITE_GOOGLE_CLIENT_ID ฝั่ง frontend ไม่งั้นการตรวจ aud จะไม่ผ่าน
GOOGLE_CLIENT_ID=

# domain อีเมลที่เข้าระบบได้ คั่นด้วย comma — PairEval เปิดใช้เฉพาะบัญชีสถาบัน
ALLOWED_EMAIL_DOMAINS=kmitl.ac.th
